<?xml version="1.0" encoding="UTF-8"?>
<!--
  AppStream metainfo embedded inside the AppImage itself (AppDir path
  usr/share/metainfo/mod-manager.metainfo.xml), read by AppImage catalog/
  discovery tooling and appstreamcli validate.

  This is a separate file from flatpak/io.github.TheMrGeeBee.MosaicModManager.metainfo.xml
  rather than a shared/reused one because <launchable> below points at
  mod-manager.desktop (the AppImage build ships that plain-named desktop
  file, not the reverse-DNS one the Flatpak build uses) — everything else
  is intentionally kept identical. The <id> itself is still reverse-DNS
  (appstreamcli's cid-desktopapp-is-not-rdns check requires it, even
  though the desktop file it launches isn't).

  Stamped at build time from src/version.py by make-appimage.sh (same
  @VERSION@ / @DATE@ token convention as the Flatpak manifest's metainfo).
-->
<component type="desktop-application">
  <id>io.github.TheMrGeeBee.MosaicModManager</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Mosaic Mod Manager</name>
  <summary>Manage game mods on Linux and the Steam Deck</summary>

  <description>
    <p>
      Mosaic is a mod manager for Linux and the Steam Deck. It installs,
      orders, and deploys mods for a wide range of games, with Nexus Mods
      integration, collections, FOMOD/BAIN installers, LOOT sorting, and
      per-profile mod lists.
    </p>
  </description>

  <launchable type="desktop-id">mod-manager.desktop</launchable>

  <categories>
    <category>Game</category>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>mod</keyword>
    <keyword>mods</keyword>
    <keyword>modding</keyword>
    <keyword>Nexus</keyword>
    <keyword>Steam Deck</keyword>
    <keyword>Baldur's Gate 3</keyword>
  </keywords>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/TheMrGeeBee/Mosaic-Mod-Manager/v1.0.4/src/icons/ui.png</image>
      <caption>The main mod list and management view</caption>
    </screenshot>
  </screenshots>

  <url type="homepage">https://github.com/TheMrGeeBee/Mosaic-Mod-Manager</url>
  <url type="bugtracker">https://github.com/TheMrGeeBee/Mosaic-Mod-Manager/issues</url>

  <developer id="io.github.themrgeebee">
    <name>MrGeeBee</name>
  </developer>

  <content_rating type="oars-1.1" />

  <releases>
    <!-- Stamped at build time from src/version.py — do not hand-edit. -->
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
